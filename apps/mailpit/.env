
# *****************************************************************************
# Mailpit
# *****************************************************************************

# Public domain name for Mailpit.
# MAILPIT_DOMAIN='mailpit.my-domain.ch'

# Username used to log into the Mailpit web UI and API.
# MAILPIT_UI_USER='admin'

# Password used to log into the Mailpit web UI and API.
# MAILPIT_UI_PASSWORD=''

# Maximum number of messages Mailpit keeps before discarding the oldest ones.
MAILPIT_MAX_MESSAGES='500'

# Maximum age of messages in either (h)ours or (d)ays. Leave empty to keep them forever.
MAILPIT_MAX_AGE='7d'
