
# *****************************************************************************
# Umami
# *****************************************************************************

# Public domain name for Umami.
# UMAMI_DOMAIN='umami.my-domain.ch'

# Server where the Umami PostgreSQL database is located.
# UMAMI_POSTGRES_SERVER=''

# User used to connect to the Umami PostgreSQL database.
# UMAMI_POSTGRES_USER=''

# Password used to connect to the Umami PostgreSQL database.
# UMAMI_POSTGRES_PASSWORD=''

# Name of the Umami PostgreSQL database.
# UMAMI_POSTGRES_DATABASE=''

# Port used to connect to the Umami PostgreSQL database.
# UMAMI_POSTGRES_PORT='5432'

# Secret used by Umami to sign authentication tokens.
# UMAMI_APP_SECRET=''
