
# *****************************************************************************
# WebFinger
# *****************************************************************************

# Public domain name that serves the WebFinger endpoint. It has to match the domain part of the email addresses of your users.
# WEBFINGER_DOMAIN='my-domain.ch'

# The OIDC issuer URL that is advertised by the WebFinger endpoint. It has to match the issuer in the /.well-known/openid-configuration of the provider exactly.
# WEBFINGER_ISSUER='https://pocket-id.my-domain.ch'
