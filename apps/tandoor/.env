
# *****************************************************************************
# Tandoor (with external PostgreSQL database)
# *****************************************************************************
#
# Signups are disabled, so the first account has to be created manually with:
# docker compose exec tandoor ./venv/bin/python manage.py createsuperuser

# Public domain name for Tandoor.
# TANDOOR_DOMAIN='tandoor.my-domain.ch'

# Secret used by Tandoor to sign session cookies.
# TANDOOR_SECRET_KEY='random'

# Server where the Tandoor PostgreSQL database is located.
# TANDOOR_POSTGRES_SERVER=''

# User used to connect to the Tandoor PostgreSQL database.
# TANDOOR_POSTGRES_USER=''

# Password used to connect to the Tandoor PostgreSQL database.
# TANDOOR_POSTGRES_PASSWORD=''

# Name of the Tandoor PostgreSQL database.
# TANDOOR_POSTGRES_DATABASE=''

# Port used to connect to the Tandoor PostgreSQL database.
# TANDOOR_POSTGRES_PORT='5432'
