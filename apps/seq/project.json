{
  "name": "seq",
  "implicitDependencies": ["networks", "traefik"],
  "targets": {
    "create-volumes": {
      "options": {
        "volumes": [
          {
            "name": "seq-data",
            "userId": 999
          }
        ]
      }
    },
    "create-variables": {
      "options": {
        "variables": [
          {
            "name": "SEQ_DOMAIN",
            "description": "Public domain name for Seq.",
            "defaultValue": "seq.${DEFAULT_DOMAIN_SUFFIX}"
          },
          {
            "name": "SEQ_INGEST_DOMAIN",
            "description": "Public domain name for Seq ingest only endpoint.",
            "defaultValue": "seq-ingest.${DEFAULT_DOMAIN_SUFFIX}"
          },
          {
            "name": "SEQ_INITIAL_USER",
            "description": "Username of the initial Seq administrator.",
            "defaultValue": "admin"
          },
          {
            "name": "SEQ_INITIAL_PASSWORD",
            "description": "Password of the initial Seq administrator.",
            "type": "password"
          }
        ]
      }
    }
  }
}
