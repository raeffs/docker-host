
# *****************************************************************************
# Mealie
# *****************************************************************************
#
# Signups are disabled. Mealie seeds an admin account on first start, log in with
# changeme@example.com / MyPassword and change the credentials right away.

# Public domain name for Mealie.
# MEALIE_DOMAIN='mealie.my-domain.ch'

# Server where the Mealie PostgreSQL database is located.
# MEALIE_POSTGRES_SERVER=''

# User used to connect to the Mealie PostgreSQL database.
# MEALIE_POSTGRES_USER=''

# Password used to connect to the Mealie PostgreSQL database.
# MEALIE_POSTGRES_PASSWORD=''

# Name of the Mealie PostgreSQL database.
# MEALIE_POSTGRES_DATABASE=''

# Port used to connect to the Mealie PostgreSQL database.
# MEALIE_POSTGRES_PORT='5432'

# SMTP server used by Mealie to send emails.
# MEALIE_SMTP_HOST=''

# SMTP port used by Mealie to send emails.
# MEALIE_SMTP_PORT='587'

# SMTP login used by Mealie to send emails.
# MEALIE_SMTP_USER=''

# SMTP password used by Mealie to send emails.
# MEALIE_SMTP_PASSWORD=''

# Sender email address used by Mealie to send emails.
# MEALIE_SMTP_FROM_ADDRESS=''
