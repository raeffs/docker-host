
# *****************************************************************************
# Linkding (with external PostgreSQL database)
# *****************************************************************************

# Public domain name for Linkding.
# LINKDING_DOMAIN='linkding.my-domain.ch'

# Server where the Linkding PostgreSQL database is located.
# LINKDING_POSTGRES_SERVER=''

# User used to connect to the Linkding PostgreSQL database.
# LINKDING_POSTGRES_USER=''

# Password used to connect to the Linkding PostgreSQL database.
# LINKDING_POSTGRES_PASSWORD=''

# Name of the Linkding PostgreSQL database.
# LINKDING_POSTGRES_DATABASE=''

# Port used to connect to the Linkding PostgreSQL database.
LINKDING_POSTGRES_PORT='5432'

# Username of the initial Linkding superuser.
# LINKDING_INITIAL_USER='admin'

# Password of the initial Linkding superuser.
# LINKDING_INITIAL_PASSWORD=''

# Django secret key for Linkding (kept stable across restarts since the data dir is ephemeral).
# LINKDING_SECRET_KEY='random'

# Domain of the OIDC provider.
# LINKDING_OAUTH_PROVIDER_DOMAIN='pocket-id.my-domain.ch'

# Client ID for Linkding to authenticate against the OIDC provider.
# LINKDING_OAUTH_CLIENT_ID=''

# Client secret for Linkding to authenticate against the OIDC provider.
# LINKDING_OAUTH_CLIENT_SECRET=''
