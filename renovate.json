{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [".github/actions/setup/action.yml"],
      "matchStrings": ["TAG=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "raeffs/tug"
    },
    {
      "description": "Seed images in create-volumes, which the docker-compose manager does not read",
      "customType": "regex",
      "managerFilePatterns": ["apps/*/project.json"],
      "matchStrings": ["\"image\": \"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ],
  "ignorePaths": ["archive"]
}
